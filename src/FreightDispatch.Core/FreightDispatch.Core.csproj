<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(EdiX12CoreProject)')">
    <ProjectReference Include="$(EdiX12CoreProject)" />
  </ItemGroup>

  <Target Name="CheckEdiX12Core" BeforeTargets="CollectPackageReferences;Restore;Build"
          Condition="!Exists('$(EdiX12CoreProject)')">
    <Error Text="EdiX12.Core was not found at '$(EdiX12CoreProject)'.%0A%0AThis project depends on the edi-x12-toolkit repository, which is pinned here as a git submodule. If you cloned without it, run:%0A%0A    git submodule update --init --recursive%0A%0A...and build again. (Cloning with --recurse-submodules does this up front.)%0A%0AAlternatively, point the build at a checkout you already have:%0A%0A    dotnet build -p:EdiX12CoreProject=&lt;path to EdiX12.Core.csproj&gt;%0A%0AOnce EdiX12.Core is published to NuGet this becomes a PackageReference and the submodule goes away — see docs/edi-toolkit-dependency.md." />
  </Target>

</Project>
