<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    EdiX12.Core lives outside this solution on purpose — the solution must stay openable by
    someone who has not initialised the submodule yet. Configuration is carried across to it
    by ShouldUnsetParentConfigurationAndPlatform in Directory.Build.props.
    See docs/edi-toolkit-dependency.md.
  -->
  <ItemGroup Condition="Exists('$(EdiX12CoreProject)')">
    <ProjectReference Include="$(EdiX12CoreProject)" />
  </ItemGroup>

  <Target Name="CheckEdiX12Core" BeforeTargets="CollectPackageReferences;Restore;Build"
          Condition="!Exists('$(EdiX12CoreProject)')">
    <Error Text="EdiX12.Core was not found. This repository pins edi-x12-toolkit as a git submodule — run 'git submodule update --init --recursive' and build again, or clone with --recurse-submodules. To build against a checkout you already have, pass -p:EdiX12CoreProject=&lt;path to EdiX12.Core.csproj&gt;. Looked in '$(EdiX12CoreProject)'. See docs/edi-toolkit-dependency.md." />
  </Target>

</Project>
