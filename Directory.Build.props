<Project>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Built against the .NET 8 targeting pack; runs on whatever major runtime is
         installed. Without this, a machine with only the 10.x runtime refuses to start
         a net8.0 app, and CI images move faster than this repo does. -->
    <RollForward>Major</RollForward>
    <!--
      When MSBuild builds a .sln it clears Configuration/Platform on the way down to any
      referenced project the solution does not itself contain. EdiX12.Core is exactly that
      (see docs/edi-toolkit-dependency.md), so without this `dotnet build -c Release` builds
      it as Debug and the Release output links a Debug assembly. Every project here is
      Any CPU and follows the solution configuration, so keeping the parent's values is
      simply correct.
    -->
    <ShouldUnsetParentConfigurationAndPlatform>false</ShouldUnsetParentConfigurationAndPlatform>
  </PropertyGroup>

  <!--
    EdiX12.Core comes from source until the NuGet package is published, and it is
    pinned as a git submodule under external/ so that a fresh clone builds without
    anything else being checked out. See docs/edi-toolkit-dependency.md.

    Resolution order:
      1. -p:EdiX12CoreProject=<path>              an explicit override wins
      2. external/edi-x12-toolkit/...             the submodule — the normal case
      3. ../edi-x12-toolkit/...                   a sibling checkout, for working on
                                                  both repositories at once
  -->
  <PropertyGroup>
    <EdiX12CoreSubmodule>$(MSBuildThisFileDirectory)external\edi-x12-toolkit\src\EdiX12.Core\EdiX12.Core.csproj</EdiX12CoreSubmodule>
    <EdiX12CoreSibling>$(MSBuildThisFileDirectory)..\edi-x12-toolkit\src\EdiX12.Core\EdiX12.Core.csproj</EdiX12CoreSibling>
    <EdiX12CoreProject Condition="'$(EdiX12CoreProject)' == '' And Exists('$(EdiX12CoreSubmodule)')">$(EdiX12CoreSubmodule)</EdiX12CoreProject>
    <EdiX12CoreProject Condition="'$(EdiX12CoreProject)' == '' And Exists('$(EdiX12CoreSibling)')">$(EdiX12CoreSibling)</EdiX12CoreProject>
    <EdiX12CoreProject Condition="'$(EdiX12CoreProject)' == ''">$(EdiX12CoreSubmodule)</EdiX12CoreProject>
  </PropertyGroup>

</Project>
